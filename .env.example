# Server Configuration
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
LOG_FILE=logs/server.log

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5175
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# Database Configuration
# Set DB_MODE=local to use LOCAL_DATABASE_URL instead of DATABASE_URL
DB_MODE=local
DATABASE_URL=postgresql://user:password@localhost:5432/jx_horizon?sslmode=disable
LOCAL_DATABASE_URL=postgresql://user:password@localhost:5432/jx_horizon?sslmode=disable
MIGRATIONS_PATH=migrations

# Authentication & Session Secrets
SESSION_SECRET=your_super_secret_session_key_change_in_production
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
ENCLAVE_SECRET=your_enclave_hmac_secret_key

# Security & Reverse Proxy (Optional)
GATEWAY_SECRET=
ADMIN_SECRET=your_admin_secret_key

# AI Services & External APIs
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
TWELVE_DATA_API_KEY=your_twelve_data_api_key
